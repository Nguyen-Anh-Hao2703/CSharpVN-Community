@page
@model CSharpVN_Community.Pages.Download_CSharpVNModel
@{
    ViewData["Title"] = "Trang Tải xuống";
}
<h1>@ViewData["Title"]</h1>
<div class="studio-header">
    <h1>CSharpVN Studio</h1>
    <p>IDE lập trình tối ưu dành cho cộng đồng Việt - Đơn giản, Mạnh mẽ, Thuần Việt.</p>
    <a href="#download" class="btn-primary" style="background-color: #ff0000; color: white; padding: 12px 25px; text-decoration: none; font-weight: bold; border-radius: 5px; display: inline-block;">
        Tải xuống ngay
    </a>
</div>

<div class="features-section">
    <h2>Tại sao chọn CSharpVN Studio?</h2>
    <div class="feature-grid">
        <div class="feature-card">
            <i class="icon">🚀</i>
            <h3>Siêu nhẹ</h3>
            <p>Khởi động tức thì, tiêu tốn cực ít tài nguyên hệ thống so với các IDE khác.</p>
        </div>
        <div class="feature-card">
            <i class="icon">🇻🇳</i>
            <h3>Tiếng Việt hơn 80%</h3>
            <p>Giao diện được Việt hóa giúp người mới học lập trình dễ tiếp cận.</p>
        </div>
        <div class="feature-card">
            <i class="icon">📦</i>
            <h3>Tích hợp CSharpVN</h3>
            <p>Sẵn sàng sử dụng bộ thư viện System, IO, Math của CSharpVN ngay khi cài đặt.</p>
        </div>
    </div>
</div>

<div id="download" class="download-section">
    <h2>Sẵn sàng bắt đầu?</h2>
    <div class="download-box">
        <h3>Phiên bản v2.0.0 (Latest)</h3>
        <p>Hỗ trợ: Windows 10/11 (64-bit)</p>
        <a href="/downloads/CSharp Vietnamese Studio Setup.exe" class="download-btn">
            Download .EXE (Setup Wizard)
        </a>
        <p style="font-size: 12px; color: #888; margin-top: 10px;">Dung lượng: ~128KB | SHA-256: checksum_xyz...</p>
    </div>
</div>
