<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CSharpVN Community</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CSharpVN_Community.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">CSharpVN Community</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Home">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Download_CSharpVN">Tải xuống</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Điều khoản sử dụng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/List">Danh sách package C#VN</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Domain">Đóng góp</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Admin/Login">Đăng nhập vào tài khoản quản trị</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="footer-container">
            <div class="footer-column">
                <h3>Hệ sinh thái CSharpVN</h3>
                <ul>
                    <li><a href="https://www.nuget.org/">NuGet Packages</a></li>
                    <li><a href="/Download_CSharpVN">CSharpVN Studio</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>C#VN so với các ngôn ngữ khác</h3>
                <ul>
                    <li><a href="https://visualstudio.microsoft.com/fr/vs/features/net-development/">Thư viện hệ thống C#</a></li>
                    <li><a href="https://intex.edu.vn/robotics-va-python-dau-la-buoc-di-dau-tien-trong-hanh-trinh-hoc-lap-trinh-cho-tre/">Python cho Robotics</a></li>
                    <li><a href="https://blog.28tech.com.vn/c">Lập trình C</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Hợp pháp</h3>
                <ul>
                    <li><a href="https://thuvienphapluat.vn/hoi-dap-phap-luat/dieu-289-bo-luat-hinh-su-quy-dinh-toi-xam-nhap-trai-phep-vao-mang-may-tinh-mang-vien-thong-hoac-phu-138064776.html">Chính sách bảo mật</a></li>
                    <li><a href="/Privacy">Điều khoản sử dụng</a></li>
                </ul>
            </div>
        </div>

        <div class="container">
            <div class="footer-bottom">
                <p>&copy; 2026 CSharpVN Community. Designed by <a href="/Author">Nguyễn Anh Hào</a>. <a href="/Privacy">Điều khoản sử dụng</a></p>
            </div> 
        </div>
        <div class="server-status-box" style="background: #000; color: #00ff00; padding: 15px; border-radius: 10px; font-family: monospace; border: 2px solid #004400; display: inline-block; margin: 20px; box-shadow: 0 0 10px #002200;">
            <h5 style="margin-top: 0; color: #00ff00; text-align: center; border-bottom: 1px solid #004400; pb-2;">🛰️ USA Main Server</h5>

            <div style="display: flex; align-items: center; gap: 20px;">
                <div class="radar-clock" style="width: 120px; height: 120px; border: 3px solid #00ff00; border-radius: 50%; position: relative; background: radial-gradient(circle, #001100, #000000); box-shadow: inset 0 0 10px #00ff00;">
                    <div style="width: 6px; height: 6px; background: #00ff00; border-radius: 50%; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 10;"></div>
                    <div id="hour-hand" style="width: 4px; height: 30px; background: #fff; position: absolute; bottom: 50%; left: 50%; transform-origin: bottom; transform: translateX(-50%) rotate(0deg); border-radius: 2px;"></div>
                    <div id="min-hand" style="width: 3px; height: 45px; background: #00ff00; position: absolute; bottom: 50%; left: 50%; transform-origin: bottom; transform: translateX(-50%) rotate(0deg); border-radius: 2px;"></div>
                    <div id="sec-hand" style="width: 1.5px; height: 55px; background: #ff0000; position: absolute; bottom: 50%; left: 50%; transform-origin: bottom; transform: translateX(-50%) rotate(0deg); transition: transform 0.1s linear;"></div>
                </div>

                <div style="font-size: 0.85rem; line-height: 1.5;">
                    <div style="color: #888;">> LOCATION: OREGON, USA</div>
                    <div style="color: #888;">> STATUS: <span style="color: #00ff00; font-weight: bold;">ACTIVE</span></div>
                    <div style="margin-top: 10px;">🕒 USA: <span id="utc-digital" style="color: #fff;">00:00:00</span></div>
                    <div>🇻🇳 VN: <span id="vn-digital" style="color: #fff;">00:00:00</span></div>
                </div>
            </div>
        </div>

        <script>
            function updateServerClock() {
                const now = new Date();

                // Tính toán thời gian (dùng giờ quốc tế cho đồng hồ kim nó ngầu)
                const ms = now.getMilliseconds();
                const sec = now.getUTCSeconds();
                const min = now.getUTCMinutes();
                const hr = now.getUTCHours();

                // Tính góc xoay trôi mượt (Smooth Sweep)
                const secDeg = ((sec + ms / 1000) / 60) * 360;
                const minDeg = ((min + sec / 60) / 60) * 360;
                const hrDeg = ((hr % 12 + min / 60) / 12) * 360;

                document.getElementById('sec-hand').style.transform = `translateX(-50%) rotate(${secDeg}deg)`;
                document.getElementById('min-hand').style.transform = `translateX(-50%) rotate(${minDeg}deg)`;
                document.getElementById('hour-hand').style.transform = `translateX(-50%) rotate(${hrDeg}deg)`;

                // Cập nhật đồng hồ số bên cạnh
                document.getElementById('utc-digital').innerText = now.getUTCHours().toString().padStart(2, '0') + ":" + min.toString().padStart(2, '0') + ":" + sec.toString().padStart(2, '0');

                const vnTime = new Date(now.getTime() + (7 * 60 * 60 * 1000));
                document.getElementById('vn-digital').innerText = vnTime.getUTCHours().toString().padStart(2, '0') + ":" + vnTime.getUTCMinutes().toString().padStart(2, '0') + ":" + vnTime.getUTCSeconds().toString().padStart(2, '0');
            }

            // Chạy mượt hơn bằng cách cập nhật 50ms một lần thay vì 1000ms
            setInterval(updateServerClock, 50);
            updateServerClock();
        </script>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
